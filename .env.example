# Copy to .env for local overrides. Point these at a PostgreSQL instance you run yourself.
DB_URL=jdbc:postgresql://localhost:5432/solarflow
DB_USERNAME=solarflow
DB_PASSWORD=1234567
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=solarflow-dev-secret-change-before-any-shared-deployment-32
COOKIE_SECURE=false
DEMO_DATA=true
STORAGE_DIR=storage
